{
	"name": "website-antrian-kelurahan",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.app.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.30.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "^24.13.3",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"mode-watcher": "^1.1.0",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.3",
		"svelte-sonner": "^1.1.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.2",
		"vite": "^8.2.0",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@supabase/postgrest-js": "^2.112.2",
		"@supabase/realtime-js": "^2.112.2",
		"valibot": "^1.4.2"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,svelte,json,css}": [
			"biome check --write --no-errors-on-unmatched"
		]
	}
}
