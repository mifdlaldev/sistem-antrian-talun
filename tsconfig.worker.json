{
	"compilerOptions": {
		"target": "es2023",
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": [
			"@cloudflare/workers-types",
			"@cloudflare/vitest-pool-workers/types"
		],
		"lib": ["es2023"]
	},
	"include": ["worker/**/*.ts", "worker-configuration.d.ts"]
}
